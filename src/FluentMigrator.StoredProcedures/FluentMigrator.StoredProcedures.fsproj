<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>FluentMigrator.StoredProcedures</PackageId>
    <Description>FluentMigrator extensions for creating and dropping PostgreSQL stored procedures.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="StoredProcedure.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator" Version="8.0.1" />
  </ItemGroup>

</Project>
